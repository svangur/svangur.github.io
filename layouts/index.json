{{- /* Copy of themes/PaperMod/layouts/index.json extended with recipe fields
so search can match on ingredients and taxonomies, not just body text. */ -}}
{{- $.Scratch.Add "index" slice -}}
{{- range site.RegularPages -}}
    {{- if and (not .Params.searchHidden) (ne .Layout `archives`) (ne .Layout `search`) }}
    {{- $.Scratch.Add "index" (dict
        "title" .Title
        "content" .Plain
        "permalink" .Permalink
        "summary" .Summary
        "ingredients" (partial "functions/flat-ingredients.html" .)
        "tags" (.Params.tags | default slice)
    ) -}}
    {{- end }}
{{- end -}}
{{- $.Scratch.Get "index" | jsonify -}}
